# ==============================================================================
# DevLab Logs Web Console Environment Template (apps/web/.env.example)
# Copy this file to `apps/web/.env.local` for local development.
# ==============================================================================

# Server Port (Next.js dev & start server)
PORT=3025

# ─── Logs Ingestion Service & Telemetry Streaming ─────────────────────────────
# Base HTTP URL for the Fastify/Express ingest service
NEXT_PUBLIC_API_URL=http://localhost:3020

# ─── DevLab Central SSO & Identity Gateway ────────────────────────────────────
# DevLab Portal API URL for authentication dispatch and session verification
NEXT_PUBLIC_DEVLAB_PORTAL_API_URL=http://localhost:3015

# DevLab Portal Web UI URL for user-facing authentication screens
NEXT_PUBLIC_DEVLAB_PORTAL_WEB_URL=http://localhost:3005
